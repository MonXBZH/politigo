# Copy to .env and adjust. Never commit the real .env: it holds the invite code.

# Code your friends type to create an account. Leave it empty and the server generates one, kept in the data
# volume and printed in its logs on every start (docker compose logs api). "off" closes registrations.
# If set: at least 16 characters, and not the example value "change-moi-en-un-code-long", or the server refuses to start.
POLITIGO_INVITE=

# Most accounts the server accepts (a leaked invite code cannot flood it).
MAX_PLAYERS=50

# Address and port the web container listens on, on the Docker host.
# Behind a reverse proxy on ANOTHER machine: the host's internal IP (never 0.0.0.0), and only the proxy let in.
# Docker's published ports bypass UFW/firewalld: filter in the DOCKER-USER chain (see README).
POLITIGO_BIND=127.0.0.1
POLITIGO_PORT=8080

# 1 = real time (production). A test server can run faster, e.g. 60 = one game hour per minute.
POLITIGO_SPEED=1

# Session cookies are HTTPS-only (Secure). Leave 1 in production; 0 only for plain-HTTP tests on another host.
COOKIE_SECURE=1

# How many proxies append to X-Forwarded-For before the API: your reverse proxy + this stack's nginx = 2.
# Use 1 when the stack is reached directly, without a reverse proxy (local tests).
PROXY_HOPS=2
