# Copy to .env and adjust. Never commit the real .env: it holds the invite code.

# Code your friends type to create an account. Leave it empty and the server generates one, kept in the data
# volume and printed in its logs on every start (docker compose logs api). "off" closes registrations.
# If set: at least 16 characters, and not the example value "change-moi-en-un-code-long", or the server refuses to start.
POLITIGO_INVITE=

# Most accounts the server accepts (a leaked invite code cannot flood it).
MAX_PLAYERS=50

# Address and port the web container listens on, on the Docker host.
# Behind a reverse proxy on ANOTHER machine: the host's internal IP (never 0.0.0.0), and only the proxy let in.
# Docker's published ports bypass UFW/firewalld: filter in the DOCKER-USER chain (see docs/DEPLOIEMENT.md).
POLITIGO_BIND=127.0.0.1
POLITIGO_PORT=8080

# 1 = real time (production). A test server can run faster, e.g. 60 = one game hour per minute.
POLITIGO_SPEED=1

# Session cookies are HTTPS-only (Secure). Leave 1 in production; 0 only for plain-HTTP tests on another host.
COOKIE_SECURE=1

# How many proxies append to X-Forwarded-For before the API: your reverse proxy + this stack's nginx = 2.
# Use 1 when the stack is reached directly, without a reverse proxy (local tests).
PROXY_HOPS=2

# Duel notifications (Web Push). Empty = on; "off" disables them. The api container then needs outbound HTTPS to the
# browsers' push services. The contact (a mailto: or https: URL) goes into every notification's signature, so a push
# service can reach the admin; empty = the project's GitHub page.
POLITIGO_PUSH=
POLITIGO_PUSH_CONTACT=

# Seasonal events, cosmetic only (plus a small daily treat). Empty = automatic: Halloween on 31 October and 1 November in
# the game time zone. "off" switches it off early; "halloween" forces it any day (tests only).
POLITIGO_EVENT=

# Players' chat, closed by default. "on" = both rooms (everyone + camp), "global" = everyone only, "camp" = camp only.
# Only the starting state of a fresh game: the admin interface (Réglages → Chat) switches it afterwards and wins.
POLITIGO_CHAT=

# Name of this game in the admin interface (handy when one admin manages several games). Empty = "PolitiGo".
POLITIGO_SERVER_NAME=

# ---- Optional admin web interface (the "admin" service; remove it from the compose file to go without) ----
# Password, at least 12 characters. Empty = one is generated at first start and printed ONCE in the admin
# container's logs (docker compose logs admin); only its hash is kept. Lost: delete the admin-pass file in the
# politigo-admin-data volume and restart, or set this variable.
POLITIGO_ADMIN_PASSWORD=
# Address and port of the admin page on the Docker host. 0.0.0.0 = every interface: restrict it to your LAN
# (firewall / DOCKER-USER), or bind 127.0.0.1 and publish it through your reverse proxy with HTTPS.
POLITIGO_ADMIN_BIND=0.0.0.0
POLITIGO_ADMIN_PORT=8090
# Behind Nginx Proxy Manager (or any one proxy): 1, so login limits apply per real client address, AND bind the port
# to 127.0.0.1 above (or firewall 8090): if clients can still reach it directly, they can fake X-Forwarded-For.
# Reached directly, without a proxy: 0.
# Login limits: 5 failed passwords per address and 30 in all per 15 minutes. Under a sustained attack the global
# cap can lock the real admin out for up to 15 minutes too (the game itself is never affected).
POLITIGO_ADMIN_PROXY_HOPS=0
# 1 = the admin cookie is HTTPS-only even if the proxy does not send X-Forwarded-Proto: https.
POLITIGO_ADMIN_COOKIE_SECURE=0
# Several games on this host, one admin socket each: "Name=/socket/path;Other name=/other/socket/path".
# Mount each other stack's socket volume into the admin container first (see the compose file). Empty = this stack only.
POLITIGO_ADMIN_SERVERS=
